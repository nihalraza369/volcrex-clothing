# Copy this file to .env.local and fill in your real credentials.

# =============================================================
# SUPABASE (admin dashboard ke liye ZAROORI)
# =============================================================
# Supabase project banao (https://supabase.com) -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jab tak yahan values khali hain:
#  - Shop website data/products.ts file chalti hai (no change dikhega)
#  - Admin dashboard open hoga lekin "Supabase not configured" warning dikhegi
#
# Baad mein products seed karne ke liye:
#   npm run seed
# (schema banane ka SQL: supabase/schema.sql — SQL Editor mein paste karo)

# =============================================================
# ADMIN LOGIN
# =============================================================
# Admin dashboard ka password (default: saim098). Yaad rakhein ki yaqeenan
# production mein isay change karein.
ADMIN_PASSWORD=saim098
# Session token sign karne ke liye secret — koi bhi lambi random string
ADMIN_SESSION_SECRET=

# =============================================================
# PAYMENTS (checkout) — abhi DEMO MODE
# =============================================================
# JazzCash — get these from your JazzCash merchant dashboard
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# EasyPaisa — get these from your EasyPaisa business dashboard
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
